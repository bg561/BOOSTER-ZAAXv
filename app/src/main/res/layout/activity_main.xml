
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090909"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="25dp">

            <ImageView
                android:layout_width="105dp"
                android:layout_height="105dp"
                android:src="@drawable/zaax_logo"
                android:scaleType="fitCenter"
                android:contentDescription="ZAAX Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BOOSTER ZAAX"
                android:textColor="#FF1744"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PREMIUM GAMING EXPERIENCE"
                android:textColor="#999999"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:paddingTop="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_zaax"
            android:padding="18dp"
            android:layout_marginBottom="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYSTEM STATUS"
                android:textColor="#FF1744"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BOOSTER ZAAX READY"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:paddingTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gaming dashboard initialized"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:paddingTop="4dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PERFORMANCE TOOLS"
            android:textColor="#FF1744"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/btn_boost_game"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="BOOST GAME"
            android:background="@drawable/zaax_button"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_anti_lag"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="ANTI LAG"
            android:background="@drawable/zaax_button"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_boost_ping"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="BOOST PING"
            android:background="@drawable/zaax_button"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_pixel_graphics"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="LOW GRAPHICS"
            android:background="@drawable/zaax_button"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_gaming_monitor"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="GAMING MONITOR"
            android:background="@drawable/zaax_button"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEVICE CONTROL"
            android:textColor="#FF1744"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="15dp"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/btn_fast_touch"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="FAST TOUCH"
            android:background="@drawable/zaax_button"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_refresh_rate"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="REFRESH RATE"
            android:background="@drawable/zaax_button"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_device_info"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="DEVICE INFORMATION"
            android:background="@drawable/zaax_button"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_cpu_info"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="CPU INFO"
            android:background="@drawable/zaax_button"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_resolution"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="RESOLUTION"
            android:background="@drawable/zaax_button"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_storage_info"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="STORAGE INFO"
            android:background="@drawable/zaax_button"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="POWERED BY ZAAX"
            android:textColor="#666666"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingTop="25dp"
            android:paddingBottom="15dp" />

    </LinearLayout>
</ScrollView>
