<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101010"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:src="@drawable/zaax_logo"
            android:contentDescription="ZAAX Logo"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BOOSTER ZAAX"
            android:textColor="#FF1744"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PREMIUM GAMING TOOL"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingBottom="25dp"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="BOOST GAME"
            android:background="@drawable/zaax_button"
            android:textColor="#FFFFFF"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="ANTI LAG"
            android:background="@drawable/zaax_button"
            android:textColor="#FFFFFF"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="BOOST PING"
            android:background="@drawable/zaax_button"
            android:textColor="#FFFFFF"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="LOW GRAPHICS"
            android:background="@drawable/zaax_button"
            android:textColor="#FFFFFF"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="FAST TOUCH"
            android:background="@drawable/zaax_button"
            android:textColor="#FFFFFF"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="DEVICE INFORMATION"
            android:background="@drawable/zaax_button"
            android:textColor="#FFFFFF"/>

    </LinearLayout>
</ScrollView>
